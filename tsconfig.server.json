{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "rootDir": "server", "outDir": "build/server",
    "rewriteRelativeImportExtensions": true,
    "types": ["node"]
  },
  "include": ["server/**/*.ts"]
}
