APP_ENV=development
VITE_APP_ENV=development
PUBLIC_ORIGIN=http://127.0.0.1:5173
PORT=3001
# Development only. Omit LOCAL_DATABASE_DIR in production.
LOCAL_DATABASE_DIR=.local/development-db
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/giveholidays_development
# Authorized by Blake on 2026-11-11.
ADMIN_EMAILS=blake@giveholidays.com
ADMIN_EMAIL=blake@giveholidays.com
# PRIVATE_SECRET: 32 cryptographically random bytes encoded as base64; do not commit it.
# PRIVATE_SECRET=
# CARA_CONTENT_PATH=/private/persistent/path/cara.json
# PRIVATE_DOCUMENT_DIR=/private/persistent/path/documents
# CLAMSCAN_PATH=/usr/bin/clamscan
LEGAL_REVIEW_APPROVED=false
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=
# Local fake-mail capture, under ignored .local only; forbidden in production:
# TEST_MAIL_DIR=.local/test-mail
# Staging requires test-only redirection and an isolated database:
# EMAIL_REDIRECT_TO=
# Production release SHA is read from release.json in the packaged release.
